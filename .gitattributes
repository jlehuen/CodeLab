# Normalisation automatique des fins de ligne
* text=auto eol=lf

# Fichiers sources et scripts Unix obligatoirement en LF
*.java text eol=lf
*.rs text eol=lf
*.sh text eol=lf
*.command text eol=lf
*.xml text eol=lf
*.toml text eol=lf
*.properties text eol=lf
*.md text eol=lf

# Scripts Windows devant impérativement rester en CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Fichiers binaires préservés tels quels
*.jar binary
*.png binary
*.jpg binary
*.dylib binary
*.jnilib binary
*.so binary
*.dll binary
*.exe binary
*.zip binary
*.tar binary
*.zst binary
*.pac binary

# Modules applicatifs et plugins téléchargeables
plugins/downloads/** binary
plugins/downloads/** linguist-vendored

# ------------------------------------------------------------------------------
# Statistiques des langages GitHub (GitHub Linguist)
# ------------------------------------------------------------------------------
# Objectif : Ne conserver que Java et Rust dans les statistiques du projet

# Outils tiers embarqués (Apache Ant et ses 42 Mo de Javadoc/manuels HTML/XSLT)
client/java/** linguist-vendored

# Sources et bibliothèques natives tierces compilées (JInput C)
client/natives/** linguist-vendored

# Gabarits et squelettes d'activités pour apprenants
client/codelab.files/** linguist-vendored

# Bibliothèques internes, modules et règles expertes
client/hidden/** linguist-vendored

# Lanceurs, scripts et installateurs multi-plateformes
client/launchers/** linguist-vendored

# Documentation et mentions légales HTML
client/data/** linguist-documentation

# Gabarits web du tableau de bord serveur
server/server/templates/** linguist-vendored

# Exclusion des scripts et formats annexes des statistiques GitHub (Java + Rust uniquement)
*.sh linguist-vendored
*.command linguist-vendored
*.bat linguist-vendored
*.cmd linguist-vendored
*.clp linguist-vendored
*.nsi linguist-vendored
*.c linguist-vendored
*.h linguist-vendored
*.html linguist-documentation

